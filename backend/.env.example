# Copiar a .env si se corre el backend fuera de docker-compose (éste ya
# inyecta REDIS_URL apuntando al servicio "redis" del propio compose).
REDIS_URL=redis://localhost:6379

# Orígenes adicionales de CORS, separados por coma (ver main.py).
# Agregar aquí el dominio de Vercel cuando exista.
CORS_EXTRA_ORIGINS=
